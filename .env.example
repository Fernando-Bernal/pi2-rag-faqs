# Copiá este archivo como .env y completá tus claves reales.
# .env NUNCA se sube a git (ya está en .gitignore).

# Proveedor primario del LLM de generación: "gemini" u "openai"
LLM_PROVIDER=gemini

# API key de Google AI Studio (proveedor primario)
GEMINI_API_KEY=your-key-here

# API key de OpenAI (usada como fallback si Gemini falla)
OPENAI_API_KEY=your-key-here

# Modelos usados por cada proveedor
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# Modelo de embeddings (Sentence-Transformers, se descarga localmente, no requiere key)
EMBEDDING_MODEL=all-MiniLM-L6-v2
